---
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg
  class="site-logo"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <rect width="64" height="64" rx="14" fill="var(--accent)" />
  <g fill="var(--bg)">
    <rect x="10.5" y="40" width="11" height="13" rx="5.5" />
    <rect x="26.5" y="32" width="11" height="21" rx="5.5" />
    <rect x="42.5" y="24" width="11" height="29" rx="5.5" />
    <circle cx="48" cy="15.5" r="5.5" />
  </g>
</svg>

<style>
  .site-logo {
    flex: 0 0 auto;
    display: block;
    transition: transform 0.18s ease;
  }
  .site-brand:hover .site-logo {
    transform: translateY(-1px);
  }
</style>
