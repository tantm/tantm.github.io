---
import type { Post } from '../lib/posts';
import { useT, type Lang } from '../i18n';

interface Props {
  older: Post | null;
  newer: Post | null;
  lang?: Lang;
  /* Bài thuộc series: prev/next là phần trước/phần sau trong series */
  seriesMode?: boolean;
}

const { older, newer, lang = 'en', seriesMode = false } = Astro.props;
const t = useT(lang);
const olderLabel = seriesMode ? t('series.prevPart') : t('post.older');
const newerLabel = seriesMode ? t('series.nextPart') : t('post.newer');
---

{
  (older || newer) && (
    <nav class="post-nav" aria-label="Post navigation">
      {older ? (
        <a href={`/blog/${older.id}`}>
          <span class="label">{olderLabel}</span>
          <span class="title">{older.data.title}</span>
        </a>
      ) : (
        <span class="spacer" />
      )}
      {newer ? (
        <a href={`/blog/${newer.id}`} class="next">
          <span class="label">{newerLabel}</span>
          <span class="title">{newer.data.title}</span>
        </a>
      ) : (
        <span class="spacer" />
      )}
    </nav>
  )
}
